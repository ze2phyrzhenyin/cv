# Reserved for the production compile worker and object storage.
# The current MVP runs without secrets.
DATABASE_URL="postgresql://resume_tex:resume_tex@localhost:5432/resume_tex"
REDIS_URL="redis://localhost:6379"
OBJECT_STORAGE_BUCKET="resume-tex-dev"

# Compile worker
# local uses latexmk/xelatex on PATH; docker runs the configured image with no network.
RESUME_TEX_COMPILE_MODE="local"
RESUME_TEX_COMPILE_TIMEOUT_MS="15000"
RESUME_TEX_WORKER_POLL_MS="1000"
RESUME_TEX_DOCKER_IMAGE="resume-tex-compiler:local"
